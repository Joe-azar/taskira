FROM node:22.23.2-bookworm-slim

WORKDIR /app

COPY package*.json ./
RUN npm install --global npm@11.9.0
RUN npm ci
RUN apt-get update \
    && apt-get install --yes --no-install-recommends socat \
    && rm -rf /var/lib/apt/lists/*
RUN npx playwright install --with-deps chromium

COPY . .
RUN chmod +x e2e/run-in-docker.sh

ENV CI=true
ENV PLAYWRIGHT_BASE_URL=http://localhost:4200

ENTRYPOINT ["e2e/run-in-docker.sh"]
