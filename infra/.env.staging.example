# Copy to infra/.env.staging (gitignored - never commit real values) and fill in real
# secrets, then run:
#
#   docker compose -f infra/docker-compose.staging.yml --env-file infra/.env.staging up
#
# To deploy a different release (including rolling back to an older one), change VERSION
# and rerun the same command - nothing else about this file needs to change.

# Required - docker-compose.staging.yml uses ${VAR:?message} for these, so compose
# refuses to start at all if they're missing.
POSTGRES_PASSWORD=change-me
# A published tag (e.g. v0.1.0) or commit SHA - see .github/workflows/release.yml,
# which pushes ghcr.io/joe-azar/taskira-backend and taskira-frontend under both.
VERSION=change-me

# Optional - sensible local default if omitted.
FRONTEND_HTTP_PORT=8081
