# Copy to infra/.env.prodlike (gitignored - never commit real values) and fill in real
# secrets, then run:
#
#   docker compose -f infra/docker-compose.prodlike.yml --env-file infra/.env.prodlike up
#
# Add --profile observability to also start Prometheus/Grafana:
#
#   docker compose -f infra/docker-compose.prodlike.yml --env-file infra/.env.prodlike --profile observability up

# Required - docker-compose.prodlike.yml uses ${VAR:?message} for these, so compose
# refuses to start at all if they're missing, rather than falling back to a weak
# default like the dev stack's "taskira"/"taskira".
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# Optional - sensible local defaults if omitted.
FRONTEND_HTTP_PORT=8080
GRAFANA_ADMIN_USER=admin
